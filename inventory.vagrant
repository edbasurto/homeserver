# Vagrant testing inventory
# Usage: ansible-playbook -i inventory.vagrant playbook.yml
#
# Spin up a VM with `vagrant up`, then target it with this inventory.
# The private key path below is generated by Vagrant after `vagrant up`.

[docker-hosts]
vagrant-host ansible_host=127.0.0.1 ansible_port=2222 ansible_user=vagrant ansible_ssh_private_key_file=./.vagrant/machines/default/virtualbox/private_key

[app_hosts]
vagrant-host
